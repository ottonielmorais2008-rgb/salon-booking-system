# Supabase project settings (Supabase dashboard > Project Settings > API).
# Copy this file to .env and fill in the values for YOUR project.
# Use only the publishable/anon key here — never the service_role key.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional, server-only. Not used by the current code; NEVER expose it to the browser or commit it.
# SUPABASE_SERVICE_ROLE_KEY=
